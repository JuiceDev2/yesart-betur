# Public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Galería Viva <onboarding@resend.dev>
OPS_EMAIL=

# Required for GET /api/cron/cleanup (min. 16 chars). Vercel Cron sends it as a Bearer token.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Optional: contact shown in the landing footer (WhatsApp: digits with country code, e.g. 5213312345678)
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
